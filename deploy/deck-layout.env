# Where things live on the Steam Deck, relative to its home directory.
#
# Plain KEY=VALUE, so it can be sourced by sh and parsed by Python. Read by
# scripts/lib.sh, deploy/deck-ctl.sh and deploy/add_steam_shortcut.py;
# deploy/tests/test_layout.py checks that nothing else repeats these names
# and that the .desktop file agrees.
DECK_CLIENT=deck-virtual-controller-client
DECK_APP=deck-controller-app
DECK_SUPERVISOR=deck_supervisor.py
DECK_BIN_DIR=.local/bin
DECK_APPS_DIR=.local/share/applications
